// --- User Variables ---
thickness = 3.175;       // 1/8 inch
length = 25.4 * 4;       // 4 inch total length
width_per_side = 25.4 * 1.5; // 1.5 inches per face
hole_spacing = 25.4 * 3; // 3 inches center-to-center
hole_diameter = 5.5;     // M5 bolt clearance
$fn = 60;

// Extension Variables
tab_reach = 25.4 * 4.5;  // 4.5 inches out from the center line
tab_width = 25.4 * 1.25;  // 1.25 inch wide tab for stability
secondary_wall_offset = 25.4 * 2.4; // 2.4 inch slide-back

// Secondary Floor Depth (1.0 inch)
secondary_floor_depth = 25.4 * 1.0; 

// Twin Support Rib Variables
tongue_rib_thickness = 6.35; // 1/4 inch (6.35mm)
tongue_rib_height = 33.0;    // 33mm (~1.3 inches) tall
rib_spacing = 18;            // 18mm center-to-center spacing

// The Target Height (2/8 inch above the top of the horizontal floor)
target_center_height = 6.35; 

// Positioning Math
edge_offset = (length - hole_spacing) / 2;
center_line_y = width_per_side / 2;

module rounded_pill_slot() {
    slot_travel = 10;
    z_start = thickness + target_center_height;
    z_end = z_start + slot_travel;

    hull() {
        translate([0, thickness/2, z_start]) 
            rotate([90, 0, 0]) 
                cylinder(h = thickness + 2, d = hole_diameter, center=true);
        translate([0, thickness/2, z_end])  
            rotate([90, 0, 0]) 
                cylinder(h = thickness + 2, d = hole_diameter, center=true);
    }
}

// Primary L-Bracket (Full floor + slotted wall)
module primary_slotted_l_bracket() {
    difference() {
        union() {
            // Full Support Floor
            hull() {
                translate([0, 0, 0]) cube([length, 1, thickness]);
                translate([0, width_per_side-1, 0]) cube([length, 1, thickness]);
            }
            // Vertical Wall
            cube([length, thickness, width_per_side]); 
        }
        
        // Wall Slots
        translate([edge_offset, 0, 0])
            rounded_pill_slot();
        translate([edge_offset + hole_spacing, 0, 0])
            rounded_pill_slot();
    }
}

// Secondary L-Bracket (Adjusted floor depth + slotted wall)
module secondary_slotted_l_bracket() {
    difference() {
        union() {
            // Secondary Support Floor
            hull() {
                translate([0, 0, 0]) cube([length, 1, thickness]);
                translate([0, secondary_floor_depth-1, 0]) cube([length, 1, thickness]);
            }
            // Full-Height Vertical Wall
            cube([length, thickness, width_per_side]); 
        }
        
        // Wall Slots (Notches)
        translate([edge_offset, 0, 0])
            rounded_pill_slot();
        translate([edge_offset + hole_spacing, 0, 0])
            rounded_pill_slot();
    }
}

// Helper module for a single tapered support rib
module single_tongue_rib(x_offset) {
    hole_y = center_line_y - tab_reach;
    rib_end_y = hole_y + 4.5; 

    hull() {
        // Anchored strictly to the FRONT face of the secondary wall (facing tongue)
        // Embedded 0.5mm into the wall for a manifold union without poking out the back
        translate([length/2 + x_offset - tongue_rib_thickness/2, -secondary_wall_offset + 0.5, thickness])
            cube([tongue_rib_thickness, 0.1, tongue_rib_height]);
        
        // Tapered tip near the mounting hole
        translate([length/2 + x_offset - tongue_rib_thickness/2, rib_end_y, thickness])
            cube([tongue_rib_thickness, 0.1, 0.1]);
    }
}

// Twin Parallel Tongue Supports
module twin_tongue_supports() {
    single_tongue_rib(-rib_spacing / 2);
    single_tongue_rib(rib_spacing / 2);
}

module final_shuttle_assembly() {
    difference() {
        union() {
            // 1. Primary L-Bracket (Full floor + Slotted Wall)
            primary_slotted_l_bracket();

            // 2. Secondary L-Bracket (1.0" floor + Slotted Wall, slid back 2.4 in)
            translate([0, -secondary_wall_offset, 0])
                secondary_slotted_l_bracket();

            // 3. Extension Tab
            translate([length/2, center_line_y, 0])
            hull() {
                cylinder(h = thickness, d = tab_width);
                translate([0, -tab_reach, 0]) 
                    cylinder(h = thickness, d = tab_width);
            }

            // 4. Reinforced Twin Support Ribs
            twin_tongue_supports();
        }

        // --- CUTOUTS (Floor Holes) ---
        
        // Fixed Holes on Primary Floor ONLY
        translate([edge_offset, center_line_y, -1])
            cylinder(h = thickness + 2, d = hole_diameter);
        translate([edge_offset + hole_spacing, center_line_y, -1])
            cylinder(h = thickness + 2, d = hole_diameter);
            
        // Extension Hole at Far End
        translate([length/2, center_line_y - tab_reach, -1])
            cylinder(h = thickness + 2, d = hole_diameter);
    }
}

final_shuttle_assembly();
