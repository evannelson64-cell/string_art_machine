[Unit]
Description=String Art Pi Server (Arduino bridge daemon)
After=network.target

[Service]
Type=simple
User=evan
WorkingDirectory=/home/evan/string_art_machine
ExecStart=/usr/bin/python3 -u /home/evan/string_art_machine/pi_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
